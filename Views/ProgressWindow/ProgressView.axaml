<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="using:AvaloniaEdit"
        xmlns:ViewModels="using:SimplePad.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="466" d:DesignHeight="120"
        x:Class="SimplePad.Views.ProgressView"
        x:DataType="ViewModels:MainViewModel"
        Padding="8">
    <StackPanel Margin="12" VerticalAlignment="Center">
		<Label Content="Current File" Padding="0"/>
        <ProgressBar Foreground="#FF00A0FF" BorderThickness="1.5" BorderBrush="#FF282828" CornerRadius="0" Background="#FF151515" Value="40" Height="20" Margin="0,6,0,10"/>
        <Button Content="Cancel" Padding="30,5" HorizontalAlignment="Right"/>
    </StackPanel>
</UserControl>
