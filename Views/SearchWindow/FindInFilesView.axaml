<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="using:AvaloniaEdit"
        xmlns:ViewModels="using:SimplePad.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="466" d:DesignHeight="218"
        x:Class="SimplePad.Views.FindInFilesView"
        x:DataType="ViewModels:MainViewModel"
        Padding="8"
        Loaded="OnLoaded">
    <Design.DataContext>
        <ViewModels:MainViewModel/>
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
			<ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
			<RowDefinition Height="64"/>
			<RowDefinition Height="64"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="FindTextBox"
                 Text="{Binding FindText}" Watermark="Find..."
                 Foreground="White" Background="{StaticResource TextEditorColor}"
                 Margin="6" Padding="5"
                 TextWrapping="NoWrap"
                 AcceptsReturn="{Binding IsMultipleLineInput}"
                 ContextFlyout="{DynamicResource TextEditorControlMenu}"
                 Grid.Column="0" Grid.Row="0">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding FindInFilesCommand}" CommandParameter="True"/>
            </TextBox.KeyBindings>
        </TextBox>
        <TextBox x:Name="ReplaceTextBox"
                 Text="{Binding ReplaceText}" Watermark="Replace..."
                 Foreground="White" Background="{StaticResource TextEditorColor}"
                 Margin="6" Padding="5"
                 TextWrapping="NoWrap"
                 AcceptsReturn="{Binding IsMultipleLineInput}"
                 ContextFlyout="{DynamicResource TextEditorControlMenu}"
                 Grid.Column="0" Grid.Row="1">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ReplaceInFilesCommand}" CommandParameter="True"/>
            </TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
            <Button Content="Find in files"
                    Command="{Binding FindInFilesCommand}"
                    Margin="0,6,0,3"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Content="Replace in files"
                    Command="{Binding ReplaceInFilesCommand}"
                    Margin="0,3"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <CheckBox Content="In all subfolders" IsChecked="{Binding InAllSubfolders}"
                      Margin="-3,-4,0,0"
                      VerticalAlignment="Center"
                      Classes="Common"/>
            <Button Content="Set current dir.."
                    Command="{Binding FileProcessingSetCurrentDirectoryCommand}"
                    IsEnabled="True"
                    Margin="0,3"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            <Button Content="..."
                    Command="{Binding FileProcessingSetDirectoryCommand}"
                    Width="36"
                    Margin="0,3"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="6,9,6,6">
            <Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
			<Label Content="Directory:" Padding="0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding FileProcessingDirectory}" FontSize="11"
                     MinHeight="28"
                     Margin="7,0,0,0" Padding="5,0,0,0"
                     VerticalContentAlignment="Center"
                     Grid.Column="1"/>
        </Grid>
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Grid.ColumnSpan="3" Grid.Row="3">
            <Border Width="117">
            </Border>
            <CheckBox Content="Match case" IsChecked="{Binding IsMatchCase}"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Classes="Common"/>
            <CheckBox Content="Multiple line input" IsChecked="{Binding IsMultipleLineInput}"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Classes="Common"/>
        </StackPanel>
    </Grid>
</UserControl>
