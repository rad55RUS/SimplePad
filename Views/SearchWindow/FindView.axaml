<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="using:AvaloniaEdit"
        xmlns:ViewModels="using:SimplePad.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="463" 
        d:DesignHeight="128"
        x:Class="SimplePad.Views.FindView"
        x:DataType="ViewModels:MainViewModel"
        Padding="8"
        Loaded="OnLoaded">
    <Design.DataContext>
        <ViewModels:MainViewModel/>
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
			<ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
			<RowDefinition Height="64"/>
			<RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="FindTextBox"
                 Text="{Binding FindText}" Watermark="Find..."
                 Foreground="White" Background="{StaticResource TextEditorColor}"
                 Margin="6" Padding="5"
                 TextWrapping="NoWrap"
                 ContextFlyout="{DynamicResource TextEditorControlMenu}"
                 Grid.Column="0" Grid.Row="0"/>
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
            <Button Content="Find next"
                    Command="{Binding FindCommand}"
                    Margin="0,6,0,3"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <Label Content="Direction"
               Background="{StaticResource DefaultBackgroundColor}"
               Width="65" Margin="6,0,0,25"
               ZIndex="1"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Grid.ColumnSpan="3" Grid.Row="1">
            <Border BorderThickness="2" BorderBrush="{StaticResource DefaultBorderColor}" Padding="4,2,7,0">
			    <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Down" IsChecked="{Binding !IsUpDirection}" VerticalAlignment="Center"/>
                    <RadioButton Content="Up" IsChecked="{Binding IsUpDirection}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <CheckBox Content="Match case" IsChecked="{Binding IsMatchCase}"
                      Margin="8,0"
                      VerticalAlignment="Center"
                      Classes="Common"/>
            <CheckBox Content="Multiple line input" IsChecked="{Binding IsMultipleLineInput}"
                      Margin="4,0"
                      VerticalAlignment="Center"
                      Classes="Common"/>
        </StackPanel>
    </Grid>
</UserControl>
