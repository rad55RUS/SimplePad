<Window xmlns="https://github.com/avaloniaui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModels="using:SimplePad.ViewModels"
		xmlns:Views="using:SimplePad.Views"
        mc:Ignorable="d" 
        x:Class="SimplePad.Views.ProgressWindow"
        x:DataType="ViewModels:MainViewModel"
        Title="SimplePad" Icon="\Icon.ico"
        Width="466" Height="115"
        CanResize="False" CanMaximize="False" CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        PointerPressed="OnBeginMoveDrag">
    <Design.DataContext>
        <ViewModels:MainViewModel/>
    </Design.DataContext>
    <Views:ProgressView VerticalAlignment="Center"/>
</Window>
